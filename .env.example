# Open-Source Diffusion Model selection on GPU:
# Options: 'flux' (FLUX.1-schnell 12B Flow Transformer - default) or 'ip-adapter' (SDXL + IP-Adapter)
DIFFUSION_MODEL_TYPE=flux
IMAGE_MODEL=FLUX.1-schnell (Open Source)

# Remote endpoint fallback (if running without local GPU)
MODEL_ENDPOINT=black-forest-labs/FLUX.1-schnell

# Sitecore Content Hub DAM Settings
SITECORE_CH_URL=https://your-tenant.sitecorecontenthub.cloud
SITECORE_USERNAME=your_username@domain.com
SITECORE_PASSWORD=your_password
SITECORE_CLIENT_ID=ImageUpload
SITECORE_CLIENT_SECRET=your_client_secret
